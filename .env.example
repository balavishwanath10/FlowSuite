# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Connection String
# Use localhost for local host dev; use 'postgres' service hostname when running inside Docker container environment
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowsuite?schema=public

# Redis Configuration
# Use localhost for local host dev; use 'redis' service hostname when running inside Docker container environment
REDIS_HOST=localhost
REDIS_PORT=6379
